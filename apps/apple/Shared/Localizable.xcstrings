            "value": "Open-source components"
          }
        }
      }
    },
    "settings.about.componentsDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放引擎 AetherEngine 与 FFmpeg 以动态框架随 App 分发，你可以按各自的许可获取源码、修改并替换。本 App 使用的 AetherEngine 修改版源码可通过下方组件链接获取，链接对应本次构建使用的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放引擎 AetherEngine 与 FFmpeg 以动态框架随 App 分发，你可以按各自的许可获取源码、修改并替换。本 App 使用的 AetherEngine 修改版源码可通过下方组件链接获取，链接对应本次构建使用的提交。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AetherEngine playback engine and FFmpeg are distributed with the app as dynamic frameworks. Their licenses allow you to obtain, modify and replace their source code. The component links below include the modified AetherEngine source used by this app and point to the commit used for this build."
          }
        }
      }
    },
    "settings.about.tmdbAttribution": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影视资料与图片由你的服务器从 TMDB（themoviedb.org）等来源获取。本产品使用 TMDB API，但未经 TMDB 认可或认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影视资料与图片由你的服务器从 TMDB（themoviedb.org）等来源获取。本产品使用 TMDB API，但未经 TMDB 认可或认证。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server obtains film and TV information and images from sources including TMDB (themoviedb.org). This product uses the TMDB API but is not endorsed or certified by TMDB."
