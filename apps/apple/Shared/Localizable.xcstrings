    "settings.about.privacySummary": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw is a client for a self-hosted service. Your media, accounts and watch history stay on your own server. The app does not upload data to the developer or any third party."
          }
        }
      }
    },
