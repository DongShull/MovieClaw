    "errors.network.timeout": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应太慢，请求已取消——请稍后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应太慢，请求已取消——请稍后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server took too long to respond. The request was cancelled; try again shortly."
          }
        }
      }
    },
    "errors.network.decoding": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回的数据无法解析（App 与服务器版本可能不一致）：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回的数据无法解析（App 与服务器版本可能不一致）：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server response could not be read. The app and server may be incompatible: %@"
          }
        }
      }
    },
    "errors.network.http": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求失败（HTTP %lld）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请求失败（HTTP %lld）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request failed (HTTP %lld)"
          }
        }
      }
    },
    "errors.network.unsupportedClient": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器还不认识%@：服务器版本太旧，请把服务器升级到最新版本后再登录（错误码 422）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器还不认识%@：服务器版本太旧，请把服务器升级到最新版本后再登录（错误码 422）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server does not recognize the %@. Update the server to the latest version, then sign in again (error 422)."
          }
        }
      }
    },
    "errors.network.versionMismatch": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这次请求：App 与服务器的版本可能不一致，请把两边都升级到最新版本后再试（错误码 422）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这次请求：App 与服务器的版本可能不一致，请把两边都升级到最新版本后再试（错误码 422）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the request. Update both the app and server to the latest version, then try again (error 422)."
          }
        }
      }
    },
    "errors.network.abnormal": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应异常"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应异常"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected server response"
          }
        }
      }
    },
    "errors.network.offlinePhone": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机没有联网：请检查 Wi-Fi 或蜂窝网络；如果其他 App 能上网，请到「设置 → MovieClaw」允许它使用无线局域网与蜂窝数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手机没有联网：请检查 Wi-Fi 或蜂窝网络；如果其他 App 能上网，请到「设置 → MovieClaw」允许它使用无线局域网与蜂窝数据"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone is offline. Check Wi-Fi or cellular data. If other apps can connect, allow MovieClaw to use Wi-Fi and cellular data in Settings > MovieClaw."
          }
        }
      }
    },
    "errors.network.offline": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@没有联网：请检查 Wi-Fi 或有线网络；连的是局域网地址时，还要在「系统设置 → 隐私与安全性 → 本地网络」里允许 MovieClaw"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@没有联网：请检查 Wi-Fi 或有线网络；连的是局域网地址时，还要在「系统设置 → 隐私与安全性 → 本地网络」里允许 MovieClaw"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ is offline. Check Wi-Fi or Ethernet. For local addresses, also allow MovieClaw under System Settings > Privacy & Security > Local Network."
          }
        }
      }
    },
    "errors.network.cellularDenied": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蜂窝数据不可用：请连接 Wi-Fi，或到「设置 → 蜂窝网络」为 MovieClaw 打开蜂窝数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蜂窝数据不可用：请连接 Wi-Fi，或到「设置 → 蜂窝网络」为 MovieClaw 打开蜂窝数据"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellular data is unavailable. Connect to Wi-Fi or enable cellular data for MovieClaw in Settings > Cellular."
          }
        }
      }
    },
    "errors.network.dns": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到%@：域名无法解析，请检查地址拼写；内网域名需要%@与服务器在同一网络"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到%@：域名无法解析，请检查地址拼写；内网域名需要%@与服务器在同一网络"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot find %@. Check the address spelling. For a local hostname, connect your %@ to the same network as the server."
          }
        }
      }
    },
    "errors.network.refused": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@拒绝连接：端口不对或服务器没在运行。请确认地址与浏览器里打开 MovieClaw 时的完全一致（包括端口）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@拒绝连接：端口不对或服务器没在运行。请确认地址与浏览器里打开 MovieClaw 时的完全一致（包括端口）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refused the connection. Check that the server is running and the address matches the one used in your browser, including the port."
          }
        }
      }
    },
    "errors.network.connectionTimeout": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接%@超时，服务器没有响应：请确认地址和端口正确、服务器在运行；局域网地址需要%@连着同一个网络"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "连接%@超时，服务器没有响应：请确认地址和端口正确、服务器在运行；局域网地址需要%@连着同一个网络"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to %@ timed out. Check the address, port and server. For a local address, connect your %@ to the same network."
          }
        }
      }
    },
    "errors.network.connectionLost": {
