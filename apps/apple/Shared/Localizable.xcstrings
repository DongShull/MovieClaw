        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放引擎 AetherEngine 与 FFmpeg 以动态框架随 App 分发，你可以按各自的许可获取源码、修改并替换。本 App 使用的 AetherEngine 修改版源码可通过下方组件链接获取，链接对应本次构建使用的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放引擎 AetherEngine 与 FFmpeg 以动态框架随 App 分发，你可以按各自的许可获取源码、修改并替换。本 App 使用的 AetherEngine 修改版源码可通过下方组件链接获取，链接对应本次构建使用的提交。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherEngine and FFmpeg are distributed as dynamic frameworks. You can obtain, modify and replace their source under their respective licenses. The component links below point to the modified AetherEngine source commit used in this build."
          }
        }
      }
    },
