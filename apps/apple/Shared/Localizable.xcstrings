    "auth.pairing.tvHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机相机，或 iPhone 上 MovieClaw「我的」页右上角的扫码，扫右边的二维码后批准。不方便扫码的话，在任何已登录的电脑或手机浏览器里打开下面的地址，输入配对码。谁批准，这台 Apple TV 就登录成谁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机相机，或 iPhone 上 MovieClaw「我的」页右上角的扫码，扫右边的二维码后批准。不方便扫码的话，在任何已登录的电脑或手机浏览器里打开下面的地址，输入配对码。谁批准，这台 Apple TV 就登录成谁。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code with your phone camera or the scanner at the top right of Me in the iPhone app, then approve the request. You can also open the address below in a signed-in browser and enter the pairing code. This Apple TV signs in as the account that approves it."
          }
        }
      }
