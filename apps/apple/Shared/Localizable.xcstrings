    "activity.boost.confirmDisable": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 还开着刷流，清理时会一并关闭，否则引擎几分钟内又会拉新种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 还开着刷流，清理时会一并关闭，否则引擎几分钟内又会拉新种。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boosting is still enabled for %@. Cleanup turns it off too; otherwise the engine would add new torrents within minutes."
          }
        }
      },
      "comment": "Boost cleanup confirmation: sites still boosting."
    },
