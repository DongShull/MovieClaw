    "settings.about.tvPrivacySummary": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。项目主页：github.com/movieclaw/movieclaw"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。项目主页：github.com/movieclaw/movieclaw"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw is a client for your self-hosted server. Your media, accounts and watch history stay on the server you deploy. The app does not upload data to the developer or any third party. Project: github.com/movieclaw/movieclaw"
          }
        }
      }
    },
    "settings.about.components": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源组件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "开源组件"
