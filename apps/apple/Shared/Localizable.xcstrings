    "common.input.maxLength": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 字，超出时无法确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 字，超出时无法确定。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Up to %lld character. Shorten the text to continue."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Up to %lld characters. Shorten the text to continue."
                }
              }
            }
          }
        }
      }
    },
