    "auth.setup.intro": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一台全新的服务器。将用下面的账号创建超级管理员——它是本站唯一的管理身份，此流程仅在首次部署时出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一台全新的服务器。将用下面的账号创建超级管理员——它是本站唯一的管理身份，此流程仅在首次部署时出现。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a new server. The account below will become its super administrator. This setup runs only once, when the server is first deployed."
          }
        }
      }
    },
    "auth.pairing.macHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机相机或 iPhone 上 MovieClaw 的扫码扫一下，在手机上批准；也可以在 iPhone「设置 → 设备」或已登录的浏览器里输入配对码。谁批准，这台 Mac 就登录成谁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机相机或 iPhone 上 MovieClaw 的扫码扫一下，在手机上批准；也可以在 iPhone「设置 → 设备」或已登录的浏览器里输入配对码。谁批准，这台 Mac 就登录成谁。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with your phone camera or the scanner in the iPhone app, then approve on your phone. You can also enter the pairing code in Settings > Devices on iPhone or in a signed-in browser. This Mac signs in as the account that approves it."
          }
        }
      }
    },
