// 签名配置入口（提交进仓库）。
//
// 开发者团队是个人信息，不入库：在同目录建 Signing.local.xcconfig（已被 .gitignore 忽略），写一行
//     DEVELOPMENT_TEAM = 你的团队 ID
// 真机安装时自动签名就会用它；没有这个文件时只能编译模拟器版本（模拟器不需要签名）。
//
// Bundle ID 前缀：App 与各 target 的 Bundle ID 都是「前缀 + 固定后缀」（.app / .MovieClawTests / …）。
// Bundle ID 在 Apple 全球唯一，用别的开发者账号签名（自己装真机、发自己的 TestFlight）时
// 不能也用 io.movieclaw，在 Signing.local.xcconfig 里再写一行覆盖即可：
//     MC_BUNDLE_ID_PREFIX = com.example.movieclaw
// CI 里也可以直接作为 xcodebuild 参数传入：MC_BUNDLE_ID_PREFIX=com.example.movieclaw
MC_BUNDLE_ID_PREFIX = io.movieclaw

// 发行版本：默认完整版（空）。商店版（对外 TestFlight / App Store）由 scripts/release.sh --store
// 以 xcodebuild 参数 MC_EDITION_CONDITIONS=MC_STORE 打开，见 App/AppEdition.swift
MC_EDITION_CONDITIONS =
#include? "Signing.local.xcconfig"
